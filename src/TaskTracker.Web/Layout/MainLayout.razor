@inherits LayoutComponentBase
@inject AuthService Auth
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <a href="account" class="me-2 text-muted" title="Account" data-testid="user-email">@context.User.Identity?.Name</a>
                    <span class="badge bg-secondary me-3" data-testid="user-role">@context.User.FindFirst("role")?.Value</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LogoutAsync">Logout</button>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("login");
    }
}

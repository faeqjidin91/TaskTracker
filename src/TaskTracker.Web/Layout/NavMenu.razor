<nav class="sidebar-nav" aria-label="Main">
    <AuthorizeView Policy="@WebPolicies.SuperAdmin">
        <Authorized>
            <NavLink class="nav-entry" href="organizations" Match="NavLinkMatch.Prefix" @onclick="OnNavigate">
                <Icon Name="building" /> Organizations
            </NavLink>
        </Authorized>
    </AuthorizeView>
    <AuthorizeView Policy="@WebPolicies.InOrganization">
        <Authorized>
            <NavLink class="nav-entry" href="projects" Match="NavLinkMatch.Prefix" @onclick="OnNavigate">
                <Icon Name="folder" /> Projects
            </NavLink>
        </Authorized>
    </AuthorizeView>
    <AuthorizeView Policy="@WebPolicies.OrganizationAdmin">
        <Authorized>
            <NavLink class="nav-entry" href="users" Match="NavLinkMatch.Prefix" @onclick="OnNavigate">
                <Icon Name="users" /> Users
            </NavLink>
        </Authorized>
    </AuthorizeView>
</nav>

@code {
    [Parameter]
    public EventCallback OnNavigate { get; set; }
}

@page "/projects"
@attribute [Authorize(Policy = WebPolicies.InOrganization)]
@inject ProjectApiClient ProjectsApi
@inject UserApiClient UsersApi
@inject IAuthorizationService Authorization
@inject NavigationManager Navigation

<PageTitle>Projects - TaskTracker</PageTitle>

<PageHeader Title="Projects" Subtitle="@(_isAdmin ? "All projects in your organization" : "Projects you own or were added to")">
    <Actions>
        <button type="button" class="btn btn-primary" @onclick="OpenCreate">
            <Icon Name="plus" /> Create project
        </button>
    </Actions>
</PageHeader>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_error is not null)
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center" role="alert">
        <span>@_error</span>
        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="LoadAsync">Retry</button>
    </div>
}
else
{
    <FilterTabs Label="Filter projects" Items="Tabs" Value="@_tab" ValueChanged="SetTab" />

    <div class="toolbar">
        <SearchBox Value="@_search" ValueChanged="SetSearch" Placeholder="Project name or owner..." />
    </div>

    <div class="table-card">
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">Project</th>
                        <th scope="col">Owner</th>
                        <th scope="col">Tasks</th>
                        <th scope="col">Your access</th>
                        <th scope="col">Created</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Filtered.Count == 0)
                    {
                        <tr><td colspan="5" class="empty-cell">@EmptyMessage</td></tr>
                    }
                    @foreach (var project in Paging.Slice(Filtered, _page))
                    {
                        <tr @key="project.Id" class="row-link" @onclick="() => Open(project)">
                            <td>
                                <a class="cell-title" href="projects/@project.Id" @onclick:stopPropagation="true">@project.Name</a>
                                @if (!string.IsNullOrWhiteSpace(project.Description))
                                {
                                    <span class="cell-sub">@project.Description</span>
                                }
                            </td>
                            <td class="nowrap">@project.OwnerEmail</td>
                            <td class="nowrap">@project.TaskCount @(project.TaskCount == 1 ? "task" : "tasks")</td>
                            <td><span class="pill @AccessClass(project)">@AccessLabel(project)</span></td>
                            <td class="nowrap">@project.CreatedAtUtc.ToString("d MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Pager Total="Filtered.Count" Page="_page" PageChanged="p => _page = p" />
    </div>
}

<Modal Open="_showCreate" Title="Create project" Busy="_creating" OnClose="() => _showCreate = false">
    @if (_createError is not null)
    {
        <div class="alert alert-danger" role="alert">@_createError</div>
    }
    <EditForm Model="_newProject" OnValidSubmit="CreateAsync">
        <DataAnnotationsValidator />
        <div class="mb-1">
            <label class="form-label" for="project-name">Name</label>
            <InputText id="project-name" class="form-control" @bind-Value="_newProject.Name" />
            <div class="field-message"><ValidationMessage For="() => _newProject.Name" /></div>
        </div>
        @if (_isAdmin)
        {
            <div class="mb-3">
                <label class="form-label" for="project-owner">Owner</label>
                <InputSelect id="project-owner" class="form-select" @bind-Value="_newProject.OwnerUserId">
                    <option value="">Me</option>
                    @foreach (var user in _owners)
                    {
                        <option value="@user.Id">@user.Email</option>
                    }
                </InputSelect>
            </div>
        }
        else
        {
            <p class="panel-note">You will be the owner of this project and can add members to it.</p>
        }
        <div class="mb-1">
            <label class="form-label" for="project-description">Description</label>
            <InputTextArea id="project-description" class="form-control" rows="3" @bind-Value="_newProject.Description" />
            <div class="field-message"><ValidationMessage For="() => _newProject.Description" /></div>
        </div>
        <div class="modal-actions">
            <button type="button" class="btn btn-outline-secondary" disabled="@_creating" @onclick="() => _showCreate = false">Cancel</button>
            <button type="submit" class="btn btn-primary" disabled="@_creating">@(_creating ? "Creating..." : "Create project")</button>
        </div>
    </EditForm>
</Modal>

@code {
    private List<ProjectDto> _projects = [];
    private List<UserDto> _owners = [];
    private NewProjectModel _newProject = new();
    private string _tab = "all";
    private string _search = string.Empty;
    private string? _currentUserId;
    private int _page = 1;
    private bool _loading = true;
    private bool _showCreate;
    private bool _creating;
    private bool _isAdmin;
    private string? _error;
    private string? _createError;

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private IReadOnlyList<FilterTab> Tabs =>
    [
        new("all", "All", _projects.Count),
        new("owned", "Owned by me", _projects.Count(IsOwned)),
        new("shared", "Others", _projects.Count(p => !IsOwned(p)))
    ];

    private List<ProjectDto> Filtered => _projects
        .Where(p => _tab switch { "owned" => IsOwned(p), "shared" => !IsOwned(p), _ => true })
        .Where(p => _search.Length == 0
            || p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || p.OwnerEmail.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private string EmptyMessage => _projects.Count > 0
        ? "No projects match these filters."
        : "No projects yet. Create your first one.";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationState;
        _currentUserId = state.User.FindFirst("sub")?.Value;
        _isAdmin = (await Authorization.AuthorizeAsync(state.User, WebPolicies.OrganizationAdmin)).Succeeded;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await ProjectsApi.GetAllAsync();

        if (result.IsSuccess)
        {
            _projects = result.Value;
        }
        else
        {
            _error = result.Error;
        }

        if (_isAdmin && result.IsSuccess)
        {
            var users = await UsersApi.GetAllAsync();
            if (users.IsSuccess)
            {
                _owners = users.Value.Where(u => u.IsActive).ToList();
            }
            else
            {
                _error = users.Error;
            }
        }

        _loading = false;
    }

    private bool IsOwned(ProjectDto project) => project.OwnerUserId == _currentUserId;

    private void SetTab(string tab)
    {
        _tab = tab;
        _page = 1;
    }

    private void SetSearch(string search)
    {
        _search = search.Trim();
        _page = 1;
    }

    private void Open(ProjectDto project) => Navigation.NavigateTo($"projects/{project.Id}");

    private void OpenCreate()
    {
        _createError = null;
        _newProject = new NewProjectModel();
        _showCreate = true;
    }

    private async Task CreateAsync()
    {
        _createError = null;
        _creating = true;

        var result = await ProjectsApi.CreateAsync(new CreateProjectRequest(
            _newProject.Name.Trim(),
            string.IsNullOrWhiteSpace(_newProject.Description) ? null : _newProject.Description.Trim(),
            string.IsNullOrEmpty(_newProject.OwnerUserId) ? null : _newProject.OwnerUserId));

        _creating = false;
        if (result.IsSuccess)
        {
            _showCreate = false;
            Navigation.NavigateTo($"projects/{result.Value.Id}");
        }
        else
        {
            _createError = result.Error;
        }
    }

    private static string AccessLabel(ProjectDto project) => project.Permissions switch
    {
        { CanManageMembers: true } => "Owner",
        { CanDelete: true } => "Admin",
        { CanManageTasks: true } => "Contributor",
        _ => "Viewer"
    };

    private static string AccessClass(ProjectDto project) => project.Permissions switch
    {
        { CanManageMembers: true } => "pill-success",
        { CanDelete: true } => "pill-warning",
        { CanManageTasks: true } => "pill-info",
        _ => string.Empty
    };

    private sealed class NewProjectModel
    {
        [Required(ErrorMessage = "Name is required.")]
        [StringLength(100, ErrorMessage = "Name must be 100 characters or fewer.")]
        public string Name { get; set; } = string.Empty;

        [StringLength(500, ErrorMessage = "Description must be 500 characters or fewer.")]
        public string? Description { get; set; }

        public string OwnerUserId { get; set; } = string.Empty;
    }
}

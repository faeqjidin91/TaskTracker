@inject IJSRuntime JS

<div class="theme-switcher" role="group" aria-label="Theme">
    @foreach (var (key, icon, label) in Options)
    {
        <button type="button" title="@label" aria-label="@label theme" aria-pressed="@(_current == key ? "true" : "false")"
                @onclick="() => SetAsync(key)">
            <Icon Name="@icon" Size="16" />
        </button>
    }
</div>

@code {
    private static readonly (string Key, string Icon, string Label)[] Options =
    [
        ("system", "monitor", "System"),
        ("light", "sun", "Light"),
        ("dark", "moon", "Dark")
    ];

    private string _current = "dark";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _current = await JS.InvokeAsync<string>("taskTrackerTheme.get");
            StateHasChanged();
        }
    }

    private async Task SetAsync(string preference)
    {
        _current = preference;
        await JS.InvokeVoidAsync("taskTrackerTheme.set", preference);
    }
}

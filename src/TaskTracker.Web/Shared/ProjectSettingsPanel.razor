@inject ProjectApiClient ProjectsApi

<div class="narrow" data-testid="project-settings">
    @if (_error is not null)
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }
    @if (_saved)
    {
        <div class="alert alert-success" role="status">Changes saved.</div>
    }

    @if (Project.Permissions.CanEdit)
    {
        <section class="panel">
            <h2>Project details</h2>
            <p class="panel-note">The name and description everyone on the project sees.</p>
            <EditForm Model="_details" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <div class="mb-1">
                    <label class="form-label" for="settings-name">Project name</label>
                    <InputText id="settings-name" class="form-control" @bind-Value="_details.Name" />
                    <div class="field-message"><ValidationMessage For="() => _details.Name" /></div>
                </div>
                <div class="mb-1">
                    <label class="form-label" for="settings-description">Project description</label>
                    <InputTextArea id="settings-description" class="form-control" rows="3" @bind-Value="_details.Description" />
                    <div class="field-message"><ValidationMessage For="() => _details.Description" /></div>
                </div>
                <button type="submit" class="btn btn-primary" disabled="@_busy">Save changes</button>
            </EditForm>
        </section>
    }

    @if (Project.Permissions.CanTransferOwner)
    {
        <section class="panel">
            <h2>Transfer ownership</h2>
            <p class="panel-note">Only the owner can assign members. The previous owner stays on the project as a Contributor.</p>
            <label class="form-label" for="settings-owner">New owner</label>
            <div class="d-flex flex-wrap gap-2">
                <select id="settings-owner" class="form-select w-auto flex-grow-1" @bind="_newOwnerId">
                    <option value="">Select a new owner</option>
                    @foreach (var candidate in _candidates.Where(c => c.UserId != Project.OwnerUserId))
                    {
                        <option value="@candidate.UserId">@candidate.Email</option>
                    }
                </select>
                <button type="button" class="btn btn-outline-secondary"
                        disabled="@(_busy || string.IsNullOrEmpty(_newOwnerId))" @onclick="() => _confirmingTransfer = true">Transfer</button>
            </div>
        </section>
    }

    @if (Project.Permissions.CanDelete)
    {
        <section class="panel panel-danger">
            <h2>Delete project</h2>
            <p class="panel-note">Permanently removes this project, its tasks, and its member list.</p>
            <button type="button" class="btn btn-outline-danger" @onclick="() => _confirmingDelete = true">
                <Icon Name="trash" Size="16" /> Delete project
            </button>
        </section>
    }
</div>

<ConfirmDialog Open="_confirmingTransfer"
               Title="Transfer ownership"
               Message="@($"Make {NewOwnerEmail} the owner of {Project.Name}?")"
               ConfirmLabel="Transfer ownership"
               Danger="false"
               Busy="_busy"
               OnConfirm="TransferAsync"
               OnCancel="() => _confirmingTransfer = false" />

<ConfirmDialog Open="_confirmingDelete"
               Title="Delete project"
               Message="@($"Delete {Project.Name} and all its tasks? This cannot be undone.")"
               ConfirmLabel="Yes, delete project"
               Busy="_busy"
               Error="@_deleteError"
               OnConfirm="DeleteAsync"
               OnCancel="CancelDelete" />

@code {
    private DetailsModel _details = new();
    private List<ProjectCandidateDto> _candidates = [];
    private string _newOwnerId = string.Empty;
    private bool _confirmingTransfer;
    private bool _confirmingDelete;
    private bool _busy;
    private bool _saved;
    private string? _error;
    private string? _deleteError;

    [Parameter, EditorRequired]
    public ProjectDto Project { get; set; } = default!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    [Parameter]
    public EventCallback OnDeleted { get; set; }

    private string NewOwnerEmail =>
        _candidates.FirstOrDefault(c => c.UserId == _newOwnerId)?.Email ?? "this user";

    protected override async Task OnInitializedAsync()
    {
        _details = new DetailsModel { Name = Project.Name, Description = Project.Description };

        if (Project.Permissions.CanTransferOwner)
        {
            var candidates = await ProjectsApi.GetCandidatesAsync(Project.Id);
            if (candidates.IsSuccess)
            {
                _candidates = candidates.Value;
            }
            else
            {
                _error = candidates.Error;
            }
        }
    }

    private async Task SaveAsync()
    {
        _error = null;
        _saved = false;
        _busy = true;

        var result = await ProjectsApi.UpdateAsync(Project.Id, new UpdateProjectRequest(
            _details.Name.Trim(),
            string.IsNullOrWhiteSpace(_details.Description) ? null : _details.Description.Trim()));

        _busy = false;
        if (result.IsSuccess)
        {
            _saved = true;
            await OnChanged.InvokeAsync();
        }
        else
        {
            _error = result.Error;
        }
    }

    private async Task TransferAsync()
    {
        _error = null;
        _saved = false;
        _busy = true;

        var result = await ProjectsApi.TransferOwnerAsync(Project.Id, _newOwnerId);

        _busy = false;
        _confirmingTransfer = false;

        if (result.IsSuccess)
        {
            await OnChanged.InvokeAsync();
        }
        else
        {
            _error = result.Error;
        }
    }

    private void CancelDelete()
    {
        _deleteError = null;
        _confirmingDelete = false;
    }

    private async Task DeleteAsync()
    {
        _deleteError = null;
        _busy = true;

        var result = await ProjectsApi.DeleteAsync(Project.Id);

        _busy = false;
        if (result.IsSuccess)
        {
            _confirmingDelete = false;
            await OnDeleted.InvokeAsync();
        }
        else
        {
            _deleteError = result.Error;
        }
    }

    private sealed class DetailsModel
    {
        [Required(ErrorMessage = "Name is required.")]
        [StringLength(100, ErrorMessage = "Name must be 100 characters or fewer.")]
        public string Name { get; set; } = string.Empty;

        [StringLength(500, ErrorMessage = "Description must be 500 characters or fewer.")]
        public string? Description { get; set; }
    }
}

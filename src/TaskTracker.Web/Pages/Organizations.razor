@page "/organizations"
@attribute [Authorize(Policy = WebPolicies.SuperAdmin)]
@inject OrganizationApiClient OrganizationsApi

<PageTitle>Organizations - TaskTracker</PageTitle>

<PageHeader Title="Organizations" Subtitle="Every tenant on this platform">
    <Actions>
        <button type="button" class="btn btn-primary" @onclick="OpenCreate">
            <Icon Name="plus" /> Create organization
        </button>
    </Actions>
</PageHeader>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_loadError is not null)
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center" role="alert">
        <span>@_loadError</span>
        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="LoadAsync">Retry</button>
    </div>
}
else
{
    @if (_success is not null)
    {
        <div class="alert alert-success alert-dismissible" role="status">
            @_success
            <button type="button" class="btn-close" aria-label="Dismiss" @onclick="() => _success = null"></button>
        </div>
    }

    <FilterTabs Label="Filter organizations" Items="Tabs" Value="@_tab" ValueChanged="SetTab" />

    <div class="toolbar">
        <SearchBox Value="@_search" ValueChanged="SetSearch" Placeholder="Search by name..." />
    </div>

    <div class="table-card">
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">Organization</th>
                        <th scope="col">Users</th>
                        <th scope="col">Status</th>
                        <th scope="col">Created</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Filtered.Count == 0)
                    {
                        <tr><td colspan="5" class="empty-cell">No organizations match these filters.</td></tr>
                    }
                    @foreach (var organization in Paging.Slice(Filtered, _page))
                    {
                        <tr @key="organization.Id">
                            <td class="cell-title">@organization.Name</td>
                            <td>@organization.UserCount</td>
                            <td>
                                <span class="pill @(organization.IsActive ? "pill-success" : null)">
                                    @(organization.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="nowrap">@organization.CreatedAtUtc.ToString("d MMM yyyy")</td>
                            <td class="cell-actions">
                                <button type="button" class="btn btn-sm btn-outline-secondary me-1"
                                        aria-label="Add admin to @organization.Name" @onclick="() => OpenAddAdmin(organization)">Add admin</button>
                                <button type="button" class="btn btn-sm @(organization.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                        aria-label="@(organization.IsActive ? "Deactivate" : "Activate") @organization.Name"
                                        @onclick="() => AskToggle(organization)">
                                    @(organization.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Pager Total="Filtered.Count" Page="_page" PageChanged="p => _page = p" />
    </div>
}

<Modal Open="_showCreate" Title="Create organization" Busy="_creating" OnClose="() => _showCreate = false">
    @if (_createError is not null)
    {
        <div class="alert alert-danger" role="alert">@_createError</div>
    }
    <EditForm Model="_newOrganization" OnValidSubmit="CreateAsync">
        <DataAnnotationsValidator />
        <div class="mb-1">
            <label class="form-label" for="organization-name">Name</label>
            <InputText id="organization-name" class="form-control" @bind-Value="_newOrganization.Name" />
            <div class="field-message"><ValidationMessage For="() => _newOrganization.Name" /></div>
        </div>
        <div class="mb-1">
            <label class="form-label" for="organization-admin-email">First admin email</label>
            <InputText id="organization-admin-email" type="email" class="form-control" autocomplete="off" @bind-Value="_newOrganization.AdminEmail" />
            <div class="field-message"><ValidationMessage For="() => _newOrganization.AdminEmail" /></div>
        </div>
        <div class="mb-1">
            <label class="form-label" for="organization-admin-password">Temporary password</label>
            <InputText id="organization-admin-password" type="password" class="form-control" autocomplete="new-password" @bind-Value="_newOrganization.AdminPassword" />
            <div class="field-message"><ValidationMessage For="() => _newOrganization.AdminPassword" /></div>
        </div>
        <div class="modal-actions">
            <button type="button" class="btn btn-outline-secondary" disabled="@_creating" @onclick="() => _showCreate = false">Cancel</button>
            <button type="submit" class="btn btn-primary" disabled="@_creating">@(_creating ? "Creating..." : "Create organization")</button>
        </div>
    </EditForm>
</Modal>

<Modal Open="_adminTarget is not null" Title="@($"Add admin to {_adminTarget?.Name}")" Busy="_addingAdmin" OnClose="() => _adminTarget = null">
    @if (_adminError is not null)
    {
        <div class="alert alert-danger" role="alert">@_adminError</div>
    }
    <EditForm Model="_newAdmin" OnValidSubmit="AddAdminAsync">
        <DataAnnotationsValidator />
        <div class="mb-1">
            <label class="form-label" for="new-admin-email">Admin email</label>
            <InputText id="new-admin-email" type="email" class="form-control" autocomplete="off" @bind-Value="_newAdmin.Email" />
            <div class="field-message"><ValidationMessage For="() => _newAdmin.Email" /></div>
        </div>
        <div class="mb-1">
            <label class="form-label" for="new-admin-password">Temporary password</label>
            <InputText id="new-admin-password" type="password" class="form-control" autocomplete="new-password" @bind-Value="_newAdmin.Password" />
            <div class="field-message"><ValidationMessage For="() => _newAdmin.Password" /></div>
        </div>
        <div class="modal-actions">
            <button type="button" class="btn btn-outline-secondary" disabled="@_addingAdmin" @onclick="() => _adminTarget = null">Cancel</button>
            <button type="submit" class="btn btn-primary" disabled="@_addingAdmin">@(_addingAdmin ? "Saving..." : "Save admin")</button>
        </div>
    </EditForm>
</Modal>

<ConfirmDialog Open="_toggleTarget is not null"
               Title="@(_toggleTarget?.IsActive == true ? "Deactivate organization" : "Activate organization")"
               Message="@(_toggleTarget?.IsActive == true ? $"Deactivate {_toggleTarget.Name}? All of its users will be signed out immediately." : $"Activate {_toggleTarget?.Name}?")"
               ConfirmLabel="@(_toggleTarget?.IsActive == true ? "Deactivate" : "Activate")"
               Danger="@(_toggleTarget?.IsActive == true)"
               Busy="_toggling"
               Error="@_toggleError"
               OnConfirm="ToggleActiveAsync"
               OnCancel="() => _toggleTarget = null" />

@code {
    private List<OrganizationDto> _organizations = [];
    private NewOrganizationModel _newOrganization = new();
    private NewAdminModel _newAdmin = new();
    private OrganizationDto? _adminTarget;
    private OrganizationDto? _toggleTarget;
    private string _tab = "all";
    private string _search = string.Empty;
    private string? _loadError;
    private string? _createError;
    private string? _adminError;
    private string? _toggleError;
    private string? _success;
    private int _page = 1;
    private bool _loading = true;
    private bool _showCreate;
    private bool _creating;
    private bool _addingAdmin;
    private bool _toggling;

    private IReadOnlyList<FilterTab> Tabs =>
    [
        new("all", "All", _organizations.Count),
        new("active", "Active", _organizations.Count(o => o.IsActive)),
        new("inactive", "Inactive", _organizations.Count(o => !o.IsActive))
    ];

    private List<OrganizationDto> Filtered => _organizations
        .Where(o => _tab switch { "active" => o.IsActive, "inactive" => !o.IsActive, _ => true })
        .Where(o => _search.Length == 0 || o.Name.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;

        var result = await OrganizationsApi.GetAllAsync();

        if (result.IsSuccess)
        {
            _organizations = result.Value;
        }
        else
        {
            _loadError = result.Error;
        }

        _loading = false;
    }

    private void SetTab(string tab)
    {
        _tab = tab;
        _page = 1;
    }

    private void SetSearch(string search)
    {
        _search = search.Trim();
        _page = 1;
    }

    private void OpenCreate()
    {
        _success = null;
        _createError = null;
        _newOrganization = new NewOrganizationModel();
        _showCreate = true;
    }

    private async Task CreateAsync()
    {
        _createError = null;
        _creating = true;

        var result = await OrganizationsApi.CreateAsync(new CreateOrganizationRequest(
            _newOrganization.Name.Trim(), _newOrganization.AdminEmail.Trim(), _newOrganization.AdminPassword));

        _creating = false;
        if (result.IsSuccess)
        {
            _organizations.Add(result.Value);
            _organizations = _organizations.OrderBy(o => o.Name, StringComparer.OrdinalIgnoreCase).ToList();
            _success = $"Created {result.Value.Name}.";
            _showCreate = false;
        }
        else
        {
            _createError = result.Error;
        }
    }

    private void AskToggle(OrganizationDto organization)
    {
        _success = null;
        _toggleError = null;
        _toggleTarget = organization;
    }

    private async Task ToggleActiveAsync()
    {
        if (_toggleTarget is not { } organization)
        {
            return;
        }

        _toggleError = null;
        _toggling = true;

        var result = await OrganizationsApi.UpdateStatusAsync(organization.Id, !organization.IsActive);

        _toggling = false;
        if (result.IsSuccess)
        {
            Replace(organization with { IsActive = !organization.IsActive });
            _toggleTarget = null;
        }
        else
        {
            _toggleError = result.Error;
        }
    }

    private void OpenAddAdmin(OrganizationDto organization)
    {
        _success = null;
        _adminError = null;
        _newAdmin = new NewAdminModel();
        _adminTarget = organization;
    }

    private async Task AddAdminAsync()
    {
        if (_adminTarget is not { } organization)
        {
            return;
        }

        _adminError = null;
        _addingAdmin = true;

        var result = await OrganizationsApi.AddAdminAsync(organization.Id, _newAdmin.Email.Trim(), _newAdmin.Password);

        _addingAdmin = false;
        if (result.IsSuccess)
        {
            _adminTarget = null;
            Replace(organization with { UserCount = organization.UserCount + 1 });
            _success = $"Added {result.Value.Email} to {organization.Name}.";
        }
        else
        {
            _adminError = result.Error;
        }
    }

    private void Replace(OrganizationDto organization)
    {
        var index = _organizations.FindIndex(o => o.Id == organization.Id);
        if (index >= 0)
        {
            _organizations[index] = organization;
        }
    }

    private sealed class NewOrganizationModel
    {
        [Required(ErrorMessage = "Name is required.")]
        [StringLength(200, ErrorMessage = "Name must be 200 characters or fewer.")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Admin email is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        [StringLength(256, ErrorMessage = "Email must be 256 characters or fewer.")]
        public string AdminEmail { get; set; } = string.Empty;

        [Required(ErrorMessage = "Temporary password is required.")]
        public string AdminPassword { get; set; } = string.Empty;
    }

    private sealed class NewAdminModel
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        [StringLength(256, ErrorMessage = "Email must be 256 characters or fewer.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Temporary password is required.")]
        public string Password { get; set; } = string.Empty;
    }
}

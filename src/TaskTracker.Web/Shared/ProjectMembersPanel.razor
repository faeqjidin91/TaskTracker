@inject ProjectApiClient ProjectsApi

<section aria-label="Project members">
    <div class="section-head">
        <h2>Members</h2>
        @if (Project.Permissions.CanManageMembers)
        {
            <button type="button" class="btn btn-primary" disabled="@(_loading || Available.Count == 0)"
                    title="@(Available.Count == 0 ? "Everyone in your organization is already on this project" : null)"
                    @onclick="OpenAdd">
                <Icon Name="plus" /> Add member
            </button>
        }
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    <div class="table-card">
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">User</th>
                        <th scope="col">Role</th>
                        @if (Project.Permissions.CanManageMembers)
                        {
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    <tr data-testid="project-owner">
                        <td class="cell-title">@Project.OwnerEmail</td>
                        <td><span class="pill pill-success">Owner</span></td>
                        @if (Project.Permissions.CanManageMembers)
                        {
                            <td></td>
                        }
                    </tr>
                    @if (_loading)
                    {
                        <tr><td colspan="3"><LoadingSpinner /></td></tr>
                    }
                    @foreach (var member in _members)
                    {
                        <tr @key="member.UserId">
                            <td>@member.Email</td>
                            <td>
                                @if (Project.Permissions.CanManageMembers)
                                {
                                    <select class="form-select form-select-sm" aria-label="Project role for @member.Email"
                                            value="@member.Role.ToString()" disabled="@_busy"
                                            @onchange="e => ChangeRoleAsync(member, e)">
                                        @foreach (var role in Enum.GetValues<ProjectRole>())
                                        {
                                            <option value="@role.ToString()">@role</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <span class="pill @(member.Role == ProjectRole.Contributor ? "pill-info" : null)">@member.Role</span>
                                }
                            </td>
                            @if (Project.Permissions.CanManageMembers)
                            {
                                <td class="cell-actions">
                                    <button type="button" class="icon-button danger" disabled="@_busy" title="Remove member"
                                            aria-label="Remove @member.Email" @onclick="() => _removeTarget = member">
                                        <Icon Name="trash" Size="16" />
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

<Modal Open="_showAdd" Title="Add member" Busy="_busy" OnClose="() => _showAdd = false">
    @if (_addError is not null)
    {
        <div class="alert alert-danger" role="alert">@_addError</div>
    }
    <div class="mb-3">
        <label class="form-label" for="member-user">User</label>
        <select id="member-user" class="form-select" @bind="_selectedUserId">
            <option value="">Select a user</option>
            @foreach (var candidate in Available)
            {
                <option value="@candidate.UserId">@candidate.Email</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label" for="member-role">Role</label>
        <select id="member-role" class="form-select" @bind="_selectedRole">
            @foreach (var role in Enum.GetValues<ProjectRole>())
            {
                <option value="@role">@role</option>
            }
        </select>
    </div>
    <div class="modal-actions">
        <button type="button" class="btn btn-outline-secondary" disabled="@_busy" @onclick="() => _showAdd = false">Cancel</button>
        <button type="button" class="btn btn-primary" disabled="@(_busy || string.IsNullOrEmpty(_selectedUserId))" @onclick="AddAsync">
            @(_busy ? "Adding..." : "Add to project")
        </button>
    </div>
</Modal>

<ConfirmDialog Open="_removeTarget is not null"
               Title="Remove member"
               Message="@($"Remove {_removeTarget?.Email} from this project?")"
               ConfirmLabel="Remove member"
               Busy="_busy"
               Error="@_removeError"
               OnConfirm="RemoveAsync"
               OnCancel="CancelRemove" />

@code {
    private List<ProjectMemberDto> _members = [];
    private List<ProjectCandidateDto> _candidates = [];
    private ProjectMemberDto? _removeTarget;
    private string _selectedUserId = string.Empty;
    private ProjectRole _selectedRole = ProjectRole.Contributor;
    private bool _loading = true;
    private bool _showAdd;
    private bool _busy;
    private string? _error;
    private string? _addError;
    private string? _removeError;

    [Parameter, EditorRequired]
    public ProjectDto Project { get; set; } = default!;

    private List<ProjectCandidateDto> Available => _candidates
        .Where(c => c.UserId != Project.OwnerUserId && _members.All(m => m.UserId != c.UserId))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        var members = await ProjectsApi.GetMembersAsync(Project.Id);
        if (members.IsSuccess)
        {
            _members = members.Value;
        }
        else
        {
            _error = members.Error;
        }

        if (Project.Permissions.CanManageMembers)
        {
            var candidates = await ProjectsApi.GetCandidatesAsync(Project.Id);
            if (candidates.IsSuccess)
            {
                _candidates = candidates.Value;
            }
            else
            {
                _error = candidates.Error;
            }
        }

        _loading = false;
    }

    private void OpenAdd()
    {
        _addError = null;
        _selectedUserId = string.Empty;
        _selectedRole = ProjectRole.Contributor;
        _showAdd = true;
    }

    private async Task AddAsync()
    {
        _addError = null;
        _busy = true;

        var result = await ProjectsApi.AddMemberAsync(Project.Id, _selectedUserId, _selectedRole);

        _busy = false;
        if (result.IsSuccess)
        {
            _members.Add(result.Value);
            _members = _members.OrderBy(m => m.Email, StringComparer.OrdinalIgnoreCase).ToList();
            _showAdd = false;
        }
        else
        {
            _addError = result.Error;
        }
    }

    private async Task ChangeRoleAsync(ProjectMemberDto member, ChangeEventArgs args)
    {
        if (!Enum.TryParse<ProjectRole>(args.Value?.ToString(), out var role) || role == member.Role)
        {
            return;
        }

        _error = null;
        _busy = true;
        Replace(member with { Role = role });

        var result = await ProjectsApi.UpdateMemberAsync(Project.Id, member.UserId, role);
        _busy = false;

        if (!result.IsSuccess)
        {
            Replace(member);
            _error = result.Error;
        }
    }

    private void CancelRemove()
    {
        _removeError = null;
        _removeTarget = null;
    }

    private async Task RemoveAsync()
    {
        if (_removeTarget is not { } member)
        {
            return;
        }

        _removeError = null;
        _busy = true;

        var result = await ProjectsApi.RemoveMemberAsync(Project.Id, member.UserId);
        _busy = false;

        if (result.IsSuccess)
        {
            _members.RemoveAll(m => m.UserId == member.UserId);
            _removeTarget = null;
        }
        else
        {
            _removeError = result.Error;
        }
    }

    private void Replace(ProjectMemberDto member)
    {
        var index = _members.FindIndex(m => m.UserId == member.UserId);
        if (index >= 0)
        {
            _members[index] = member;
        }
    }
}

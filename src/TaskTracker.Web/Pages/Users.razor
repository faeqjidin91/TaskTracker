@page "/users"
@attribute [Authorize(Policy = WebPolicies.OrganizationAdmin)]
@inject UserApiClient UsersApi

<PageTitle>Users - TaskTracker</PageTitle>

<PageHeader Title="Users" Subtitle="People in your organization and their roles">
    <Actions>
        <button type="button" class="btn btn-primary" @onclick="OpenAdd">
            <Icon Name="plus" /> Add user
        </button>
    </Actions>
</PageHeader>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_loadError is not null)
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center" role="alert">
        <span>@_loadError</span>
        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="LoadAsync">Retry</button>
    </div>
}
else
{
    @if (_actionError is not null)
    {
        <div class="alert alert-danger alert-dismissible" role="alert">
            @_actionError
            <button type="button" class="btn-close" aria-label="Dismiss" @onclick="() => _actionError = null"></button>
        </div>
    }
    @if (_success is not null)
    {
        <div class="alert alert-success alert-dismissible" role="status">
            @_success
            <button type="button" class="btn-close" aria-label="Dismiss" @onclick="() => _success = null"></button>
        </div>
    }

    <FilterTabs Label="Filter users" Items="Tabs" Value="@_tab" ValueChanged="SetTab" />

    <div class="toolbar">
        <SearchBox Value="@_search" ValueChanged="SetSearch" Placeholder="Search by email..." />
    </div>

    <div class="table-card">
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">User</th>
                        <th scope="col">Role</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Filtered.Count == 0)
                    {
                        <tr><td colspan="4" class="empty-cell">No users match these filters.</td></tr>
                    }
                    @foreach (var user in Paging.Slice(Filtered, _page))
                    {
                        var isSelf = IsSelf(user);
                        var busy = _busyUserIds.Contains(user.Id);

                        <tr @key="user.Id">
                            <td>
                                <span class="cell-title">@user.Email</span>
                                @if (isSelf)
                                {
                                    <small class="text-muted ms-1">(you)</small>
                                }
                            </td>
                            <td>
                                <select class="form-select form-select-sm" aria-label="Role for @user.Email"
                                        value="@user.Role.ToString()" disabled="@(isSelf || busy)"
                                        @onchange="e => ChangeRoleAsync(user, e)">
                                    @foreach (var role in Enum.GetValues<OrganizationRole>())
                                    {
                                        <option value="@role.ToString()">@role</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <span class="pill @(user.IsActive ? "pill-success" : null)">
                                    @(user.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="cell-actions">
                                @if (!isSelf)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1" disabled="@busy"
                                            aria-label="Reset password for @user.Email" @onclick="() => OpenReset(user)">
                                        <Icon Name="key" Size="14" /> Reset password
                                    </button>
                                    <button type="button" class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                            disabled="@busy" aria-label="@(user.IsActive ? "Deactivate" : "Activate") @user.Email"
                                            @onclick="() => AskToggle(user)">
                                        @(user.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Pager Total="Filtered.Count" Page="_page" PageChanged="p => _page = p" />
    </div>
}

<Modal Open="_showAdd" Title="Add user" Busy="_adding" OnClose="() => _showAdd = false">
    @if (_addError is not null)
    {
        <div class="alert alert-danger" role="alert">@_addError</div>
    }
    <EditForm Model="_newUser" OnValidSubmit="AddUserAsync">
        <DataAnnotationsValidator />
        <div class="mb-1">
            <label class="form-label" for="user-email">Email</label>
            <InputText id="user-email" type="email" class="form-control" autocomplete="off" @bind-Value="_newUser.Email" />
            <div class="field-message"><ValidationMessage For="() => _newUser.Email" /></div>
        </div>
        <div class="mb-1">
            <label class="form-label" for="user-password">Temporary password</label>
            <InputText id="user-password" type="password" class="form-control" autocomplete="new-password" @bind-Value="_newUser.Password" />
            <div class="field-message"><ValidationMessage For="() => _newUser.Password" /></div>
        </div>
        <div class="mb-3">
            <label class="form-label" for="user-role">Role</label>
            <InputSelect id="user-role" class="form-select" @bind-Value="_newUser.Role">
                @foreach (var role in Enum.GetValues<OrganizationRole>())
                {
                    <option value="@role">@role</option>
                }
            </InputSelect>
        </div>
        <div class="modal-actions">
            <button type="button" class="btn btn-outline-secondary" disabled="@_adding" @onclick="() => _showAdd = false">Cancel</button>
            <button type="submit" class="btn btn-primary" disabled="@_adding">@(_adding ? "Adding..." : "Add user")</button>
        </div>
    </EditForm>
</Modal>

<Modal Open="_resetTarget is not null" Title="@($"Reset password for {_resetTarget?.Email}")" Busy="_resetting" OnClose="() => _resetTarget = null">
    @if (_resetError is not null)
    {
        <div class="alert alert-danger" role="alert">@_resetError</div>
    }
    <EditForm Model="_reset" OnValidSubmit="ResetPasswordAsync">
        <DataAnnotationsValidator />
        <div class="mb-1">
            <label class="form-label" for="reset-password">New password</label>
            <InputText id="reset-password" type="password" class="form-control" autocomplete="new-password" @bind-Value="_reset.Password" />
            <div class="field-message"><ValidationMessage For="() => _reset.Password" /></div>
        </div>
        <div class="modal-actions">
            <button type="button" class="btn btn-outline-secondary" disabled="@_resetting" @onclick="() => _resetTarget = null">Cancel</button>
            <button type="submit" class="btn btn-primary" disabled="@_resetting">@(_resetting ? "Saving..." : "Save password")</button>
        </div>
    </EditForm>
</Modal>

<ConfirmDialog Open="_toggleTarget is { IsActive: false }"
               Title="Activate user"
               Message="@($"Activate {_toggleTarget?.Email}?")"
               ConfirmLabel="Activate"
               Danger="false"
               Busy="_toggling"
               Error="@_toggleError"
               OnConfirm="ToggleActiveAsync"
               OnCancel="() => _toggleTarget = null" />

<Modal Open="_toggleTarget is { IsActive: true }" Title="Deactivate user" Busy="_toggling" OnClose="() => _toggleTarget = null">
    @if (_toggleError is not null)
    {
        <div class="alert alert-danger" role="alert">@_toggleError</div>
    }
    <p>Deactivate <strong>@_toggleTarget?.Email</strong>? They will be signed out immediately.</p>

    @if (_ownedProjects.Count > 0)
    {
        <p class="mb-1">They own @_ownedProjects.Count @(_ownedProjects.Count == 1 ? "project" : "projects"). Choose who takes over:</p>
        <ul class="owned-projects">
            @foreach (var project in _ownedProjects)
            {
                <li @key="project.Id">@project.Name</li>
            }
        </ul>
        <div class="mb-3">
            <label class="form-label" for="reassign-owner">New owner</label>
            <select id="reassign-owner" class="form-select" @bind="_newOwnerId">
                <option value="">Select a new owner</option>
                @foreach (var candidate in _users.Where(u => u.IsActive && u.Id != _toggleTarget?.Id))
                {
                    <option value="@candidate.Id">@candidate.Email</option>
                }
            </select>
        </div>
    }

    <div class="modal-actions">
        <button type="button" class="btn btn-outline-secondary" disabled="@_toggling" @onclick="() => _toggleTarget = null">Cancel</button>
        <button type="button" class="btn btn-danger" disabled="@(_toggling || (_ownedProjects.Count > 0 && string.IsNullOrEmpty(_newOwnerId)))"
                @onclick="ToggleActiveAsync">
            @(_toggling ? "Working..." : _ownedProjects.Count > 0 ? "Reassign and deactivate" : "Deactivate")
        </button>
    </div>
</Modal>

@code {
    private readonly HashSet<string> _busyUserIds = [];
    private List<UserDto> _users = [];
    private List<OwnedProjectDto> _ownedProjects = [];
    private string _newOwnerId = string.Empty;
    private NewUserModel _newUser = new();
    private ResetModel _reset = new();
    private UserDto? _resetTarget;
    private UserDto? _toggleTarget;
    private string _tab = "all";
    private string _search = string.Empty;
    private string? _currentUserId;
    private string? _loadError;
    private string? _actionError;
    private string? _addError;
    private string? _resetError;
    private string? _toggleError;
    private string? _success;
    private int _page = 1;
    private bool _loading = true;
    private bool _showAdd;
    private bool _adding;
    private bool _resetting;
    private bool _toggling;

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private IReadOnlyList<FilterTab> Tabs =>
    [
        new("all", "All", _users.Count),
        new("active", "Active", _users.Count(u => u.IsActive)),
        new("inactive", "Inactive", _users.Count(u => !u.IsActive)),
        new("admins", "Admins", _users.Count(u => u.Role == OrganizationRole.Admin))
    ];

    private List<UserDto> Filtered => _users
        .Where(u => _tab switch
        {
            "active" => u.IsActive,
            "inactive" => !u.IsActive,
            "admins" => u.Role == OrganizationRole.Admin,
            _ => true
        })
        .Where(u => _search.Length == 0 || u.Email.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        _currentUserId = (await AuthenticationState).User.FindFirst("sub")?.Value;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;

        var result = await UsersApi.GetAllAsync();

        if (result.IsSuccess)
        {
            _users = result.Value;
        }
        else
        {
            _loadError = result.Error;
        }

        _loading = false;
    }

    private void SetTab(string tab)
    {
        _tab = tab;
        _page = 1;
    }

    private void SetSearch(string search)
    {
        _search = search.Trim();
        _page = 1;
    }

    private void OpenAdd()
    {
        ClearMessages();
        _addError = null;
        _newUser = new NewUserModel();
        _showAdd = true;
    }

    private async Task AddUserAsync()
    {
        _addError = null;
        _adding = true;

        var result = await UsersApi.CreateAsync(
            new CreateUserRequest(_newUser.Email.Trim(), _newUser.Password, _newUser.Role));

        _adding = false;
        if (result.IsSuccess)
        {
            _users.Add(result.Value);
            _users = _users.OrderBy(u => u.Email, StringComparer.OrdinalIgnoreCase).ToList();
            _success = $"Added {result.Value.Email}.";
            _showAdd = false;
        }
        else
        {
            _addError = result.Error;
        }
    }

    private async Task ChangeRoleAsync(UserDto user, ChangeEventArgs args)
    {
        if (!Enum.TryParse<OrganizationRole>(args.Value?.ToString(), out var role) || role == user.Role)
        {
            return;
        }

        ClearMessages();
        _busyUserIds.Add(user.Id);
        ReplaceUser(user with { Role = role });

        var result = await UsersApi.UpdateRoleAsync(user.Id, role);
        _busyUserIds.Remove(user.Id);

        if (!result.IsSuccess)
        {
            ReplaceUser(user);
            _actionError = result.Error;
        }
    }

    private async Task AskToggle(UserDto user)
    {
        ClearMessages();
        _toggleError = null;
        _newOwnerId = string.Empty;
        _ownedProjects = [];

        if (user.IsActive)
        {
            _busyUserIds.Add(user.Id);
            var owned = await UsersApi.GetOwnedProjectsAsync(user.Id);
            _busyUserIds.Remove(user.Id);

            if (!owned.IsSuccess)
            {
                _actionError = owned.Error;
                return;
            }

            _ownedProjects = owned.Value;
        }

        _toggleTarget = user;
    }

    private async Task ToggleActiveAsync()
    {
        if (_toggleTarget is not { } user)
        {
            return;
        }

        _toggleError = null;
        _toggling = true;
        _busyUserIds.Add(user.Id);

        var newOwner = user.IsActive && _ownedProjects.Count > 0 ? _newOwnerId : null;
        var result = await UsersApi.UpdateStatusAsync(user.Id, !user.IsActive, newOwner);

        _busyUserIds.Remove(user.Id);
        _toggling = false;

        if (result.IsSuccess)
        {
            ReplaceUser(user with { IsActive = !user.IsActive });
            _toggleTarget = null;
        }
        else
        {
            _toggleError = result.Error;
        }
    }

    private void OpenReset(UserDto user)
    {
        ClearMessages();
        _resetError = null;
        _reset = new ResetModel();
        _resetTarget = user;
    }

    private async Task ResetPasswordAsync()
    {
        if (_resetTarget is not { } user)
        {
            return;
        }

        _resetError = null;
        _resetting = true;

        var result = await UsersApi.ResetPasswordAsync(user.Id, _reset.Password);

        _resetting = false;
        if (result.IsSuccess)
        {
            _resetTarget = null;
            _success = $"Password reset for {user.Email}.";
        }
        else
        {
            _resetError = result.Error;
        }
    }

    private void ClearMessages()
    {
        _actionError = null;
        _success = null;
    }

    private void ReplaceUser(UserDto user)
    {
        var index = _users.FindIndex(u => u.Id == user.Id);
        if (index >= 0)
        {
            _users[index] = user;
        }
    }

    private bool IsSelf(UserDto user) =>
        string.Equals(user.Id, _currentUserId, StringComparison.OrdinalIgnoreCase);

    private sealed class NewUserModel
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        [StringLength(256, ErrorMessage = "Email must be 256 characters or fewer.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Temporary password is required.")]
        public string Password { get; set; } = string.Empty;

        public OrganizationRole Role { get; set; } = OrganizationRole.Member;
    }

    private sealed class ResetModel
    {
        [Required(ErrorMessage = "New password is required.")]
        public string Password { get; set; } = string.Empty;
    }
}

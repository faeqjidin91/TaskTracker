# Copy to .env. This file is for local setup, and .env must never be committed.

# SQL Server requires 8+ characters with 3 of: uppercase, lowercase, digit, symbol.
MSSQL_SA_PASSWORD=change-me

# SuperAdmin: seeded in every environment, only if none exists yet.
# Deployment refuses the example password below, so set a strong one there.
Seed__SuperAdminEmail=superadmin@tasktracker.local
Seed__SuperAdminPassword=Passw0rd!

# Development only: ignored in deployment.
Seed__OrganizationName="Default Organization"
Seed__AdminEmail=admin@tasktracker.local
Seed__AdminPassword=Passw0rd!

# Docker: scripts/docker-build generates this key when it is empty.
JWT_SIGNING_KEY=

# Docker: ports on your machine.
WEB_PORT=8090
API_PORT=8091
